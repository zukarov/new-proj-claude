# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your real values below
# 3. Never commit .env to git (it is already in .gitignore)
# =============================================================================

# =============================================================================
# ANTHROPIC (Claude AI)
# Get your key at: https://console.anthropic.com/settings/keys
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
CLAUDE_MODEL=claude-sonnet-4-6

# =============================================================================
# POLYMARKET / POLYGON WALLET
#
# POLYGON_PRIVATE_KEY  — the private key of your Polygon EOA wallet.
#   ⚠️  Keep this secret. Never share or commit it.
#   Format: 0x followed by 64 hex characters
#   Example: 0xabc123...def456
#
# POLYMARKET_FUNDER    — the *public* wallet address (checksummed or lowercase).
#   This is the address that holds your USDC.e on Polygon mainnet.
#   Format: 0x followed by 40 hex characters
#   Example: 0xAbCd1234...
#
# SIGNATURE_TYPE:
#   0 = standard EOA wallet (MetaMask, hardware wallet, generated key)
#   1 = Magic/email wallet (if you signed up to Polymarket with email)
#   Use 0 if you generated your key yourself or use MetaMask.
# =============================================================================
POLYGON_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
POLYMARKET_FUNDER=0xYOUR_WALLET_ADDRESS_HERE
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
SIGNATURE_TYPE=0

# Polygon RPC for reading your USDC balance (public endpoint, no key needed)
POLYGON_RPC_URL=https://polygon-rpc.com

# =============================================================================
# BOT BEHAVIOR
#
# DRY_RUN=true  → safe mode: analyzes markets but never sends real orders.
#                 Uses DRY_RUN_BALANCE_USDC as simulated bankroll.
# DRY_RUN=false → live mode: real orders on Polygon mainnet with real USDC.
#                 Requires POLYGON_PRIVATE_KEY and POLYMARKET_FUNDER to be set.
# =============================================================================
DRY_RUN=true
DRY_RUN_BALANCE_USDC=1000.0

SCAN_INTERVAL_SECONDS=300
MAX_MARKETS_PER_SCAN=20
MIN_MARKET_LIQUIDITY_USDC=1000.0

# =============================================================================
# RISK PARAMETERS
# =============================================================================
MAX_PORTFOLIO_RISK_PCT=0.02      # Max 2% of bankroll per trade
MAX_SINGLE_POSITION_PCT=0.10    # Hard cap: no position > 10% of bankroll
MIN_EDGE_THRESHOLD=0.05         # Only trade when edge >= 5 percentage points
KELLY_FRACTION=0.5              # Half-Kelly sizing (conservative)
MAX_OPEN_POSITIONS=10           # Circuit breaker: stop opening if >= 10 positions open
STOP_LOSS_PCT=0.20              # Exit position if down 20%
MAX_DRAWDOWN_PCT=0.15           # Halt all trading if portfolio down 15% from peak

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.jsonl
