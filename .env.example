# Polymarket / Ethereum (Polygon mainnet)
POLYGON_PRIVATE_KEY=0x_your_private_key_here
POLYMARKET_FUNDER=0x_your_wallet_address_here
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
SIGNATURE_TYPE=1

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# Risk Parameters
MAX_PORTFOLIO_RISK_PCT=0.02
MAX_SINGLE_POSITION_PCT=0.10
MIN_EDGE_THRESHOLD=0.05
KELLY_FRACTION=0.5
MAX_OPEN_POSITIONS=10
STOP_LOSS_PCT=0.20
MAX_DRAWDOWN_PCT=0.15

# Bot Behavior
DRY_RUN=true
SCAN_INTERVAL_SECONDS=300
MAX_MARKETS_PER_SCAN=20
MIN_MARKET_LIQUIDITY_USDC=1000.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.jsonl
